{
  "rules": {
    ".read": false,
    ".write": false,
    "system": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "stock": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$videoId": {
        "$itemId": {
          ".validate": "newData.hasChildren(['num']) && newData.child('num').isNumber()"
        }
      }
    },
    "chats": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$videoId": {
        "$msgId": {
          ".validate": "newData.hasChildren(['text', 'timestamp']) && newData.child('text').isString() && newData.child('text').val().length <= 2000"
        }
      }
    },
    "delivery_customers": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "address_book": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "nicknames": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "settings": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "blacklist": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "voice_chats": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$videoId": {
        "$chatId": {
          ".validate": "newData.hasChildren(['text', 'timestamp']) && newData.child('text').isString() && newData.child('text').val().length <= 2000"
        }
      }
    },
    "history": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "notes": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "shipping": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "presence": {
      ".read": "auth != null",
      ".write": "auth != null"
    }
  }
}
