# ═══════════════════════════════════════════════════════════════
# Manowzab Command Center — Environment Variables
# คัดลอกไฟล์นี้เป็น .env แล้วกรอกค่า API Keys
# cp .env.example .env
# ═══════════════════════════════════════════════════════════════

# ─── Firebase Config ──────────────────────────────────────────
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://your_project-default-rtdb.region.firebasedatabase.app
VITE_FIREBASE_PROJECT_ID=your_project_id

# ─── YouTube Data API Keys (คั่นด้วย comma) ──────────────────
# ใช้สำหรับดึงแชทสดจาก YouTube (รองรับหลาย keys แบบ round-robin)
VITE_YOUTUBE_API_KEYS=key1,key2,key3

# ─── Google Cloud TTS API Keys (คั่นด้วย comma) ──────────────
# ใช้สำหรับ Text-to-Speech อ่านข้อความแชท
VITE_GOOGLE_API_KEYS=key1,key2

# บัญชีผู้ดูแลต้องสร้างใน Firebase Authentication (Email/Password)
# และกำหนด admin_users/<Firebase UID> = true ผ่าน Firebase Console เท่านั้น
# ห้ามใส่รหัสผ่านในตัวแปร VITE_* เพราะจะถูกบรรจุใน JavaScript ที่เผยแพร่

# Python transcriber เท่านั้น (ห้ามเติม VITE_ ข้างหน้าตัวแปรเหล่านี้)
# ต้องมีสิทธิ์ admin_users/<UID> = true เช่นเดียวกับผู้ดูแล
# FIREBASE_TRANSCRIBER_EMAIL=transcriber@example.com
# FIREBASE_TRANSCRIBER_PASSWORD=your_local_secret

# ทดสอบกับ Emulator ใน dev เท่านั้น: npm run dev -- --mode review
# VITE_USE_FIREBASE_EMULATORS=true
